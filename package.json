{
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "gitdesktop":"git -C ./reactapp/DesktopBrailleRAP/  pull",
    "clean": "rimraf  --glob \"./app/static/desktopbrap/*\"",
    "update": "npx cpx -v ./reactapp/DesktopBrailleRAP/build/**  ./app/static/desktopbrap/",
    "desktop": "npm --prefix ./reactapp/DesktopBrailleRAP run buildportal",
    "tailwindbuildlocal": "npx tailwindcss -i tailwind/style.css -c tailwind/tailwind.config.js -o ./app/static/index.css",
    "tailwindbuildmini": "npx tailwindcss -i tailwind/style.css -c tailwind/tailwind.config.js -o ./app/static/index.css --minify",
    "tailwindwatch": "npx tailwindcss -i tailwind/style.css -c tailwind/tailwind.config.js -o ./app/static/index.css --watch",
    "build": "npm-run-all tailwindbuildmini clean desktop update",
    "flasklaunch":"python portal.py",
    "start":"npm-run-all gitdesktop build flasklaunch"
  }
}
